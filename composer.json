{
    "name": "touqeershafi/laravel-inbound-email",
    "description": "Multi-provider inbound email webhooks for Laravel (Mailgun, Postmark, SendGrid, SES, Mailpit, Resend).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Touqeer Shafi"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "svix/svix": "^1.0",
        "symfony/mime": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^8.22|^9.0|^10.0",
        "phpstan/phpstan": "^1.11|^2.0",
        "phpstan/phpstan-strict-rules": "^1.5|^2.0",
        "phpunit/phpunit": "^10.5|^11.5"
    },
    "autoload": {
        "psr-4": {
            "Touqeershafi\\LaravelInboundEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Touqeershafi\\LaravelInboundEmail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Touqeershafi\\LaravelInboundEmail\\InboundEmailServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}